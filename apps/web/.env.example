# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# Only VITE_-prefixed vars are exposed to the client bundle (Vite convention).

# Public read base URL of the image bucket / CDN (CloudFront in front of the S3 bucket).
# Liveries/headshots are read by convention from this base (see AGENTS.md "Images").
# Leave unset to fall back to placeholder thumbnails (no images).
VITE_IMAGE_BASE_URL=https://your-distribution.cloudfront.net
